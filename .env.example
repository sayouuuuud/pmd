# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Long random secret used by Better Auth
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Public application URL used by Better Auth callbacks and cookies
BETTER_AUTH_URL=http://localhost:3000

# Public experimental feature flags. Keep disabled until the corresponding
# server, ownership, recovery, and production gates are complete.
NEXT_PUBLIC_PMD_ENABLE_EXPERIMENTAL_2FA=0
NEXT_PUBLIC_PMD_ENABLE_EXPERIMENTAL_CLIENT_PORTAL=0
NEXT_PUBLIC_PMD_ENABLE_EXPERIMENTAL_CLIENT_CREDENTIALS=0
NEXT_PUBLIC_PMD_ENABLE_EXPERIMENTAL_WORKSPACE_SHARING=0
NEXT_PUBLIC_PMD_ENABLE_EXPERIMENTAL_RESOURCE_LIBRARY=0
NEXT_PUBLIC_PMD_ENABLE_EXPERIMENTAL_BILLING=0
NEXT_PUBLIC_PMD_ENABLE_EXPERIMENTAL_WINDOWS_AGENT=0
NEXT_PUBLIC_PMD_ENABLE_EXPERIMENTAL_WINDOWS_SENSITIVE_COLLECTION=0
